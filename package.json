{
  "name": "sports-data-io",
  "version": "1.0",
  "description": "NFL API - OpenAPI 3.1 Specification, NBA API - OpenAPI 3.1 Specification, MLB API - OpenAPI 3.1 Specification, NHL API - OpenAPI 3.1 Specification, CFB API - OpenAPI 3.1 Specification, CBB API - OpenAPI 3.1 Specification, WNBA API - OpenAPI 3.1 Specification, CWBB API - OpenAPI 3.1 Specification, SOCCER API - OpenAPI 3.1 Specification, GOLF API - OpenAPI 3.1 Specification, NASCAR API - OpenAPI 3.1 Specification, MMA API - OpenAPI 3.1 Specification",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.tshy.json",
    "selfLink": false
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsconfig.tshy.json",
    "README.md",
    "api-reference.md",
    "sdk-map.md",
    "map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tshy",
    "build": "tshy",
    "smoke": "node -e \"require('sports-data-io')\" && node --input-type=module -e \"import('sports-data-io')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:dom": "tsc --noEmit -p tsconfig.dom.json",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tshy": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  }
}
